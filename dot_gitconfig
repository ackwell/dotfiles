[init]
	defaultBranch = main
[diff]
	colorMoved = default

[sequence]
	editor = interactive-rebase-tool
[interactive-rebase-tool]
	inputAbort = ESC
	inputForceRebase = Control+Enter
	inputMoveSelectionUp = Alt+Up
	inputMoveSelectionDown = Alt+Down

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[user]
	signingKey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg.ssh]
	program = ~/.git-ssh-sign
[commit]
	gpgSign = true
[tag]
	gpgSign = true
