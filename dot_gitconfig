[init]
	defaultBranch = main
[diff]
	colorMoved = default

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[user]
	signingKey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgSign = true
[tag]
	gpgSign = true
