{
	// Editing
	"editor.tabSize": 2,
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"editor.formatOnSave": true,
	"editor.wordWrap": "on",
	"editor.selectionClipboard": false,
	// Behavior
	"explorer.autoReveal": "focusNoScroll",
	"workbench.editor.closeEmptyGroups": false,
	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.useModal": "off",
	"editor.codeLens": false,
	"editor.inlayHints.enabled": "offUnlessPressed",
	"security.workspace.trust.untrustedFiles": "newWindow",
	// VCS
	"git.enableCommitSigning": true,
	"git.enableSmartCommit": true,
	"git.confirmSync": false,
	// Languages
	"rust-analyzer.cargo.features": "all",
	"rust-analyzer.check.command": "clippy",
	// Theme
	"workbench.colorTheme": "Catppuccin Macchiato",
	"workbench.iconTheme": "catppuccin-macchiato",
	"workbench.experimental.modernUI": false,
	"editor.fontSize": 12,
	"json.schemaDownload.trustedDomains": {
		"https://raw.githubusercontent.com/catppuccin/vscode/": true
	},
	"catppuccin.accentColor": "maroon",
	"catppuccin.italicKeywords": false,
	"catppuccin-icons.specificFolders": false,
	"catppuccin-icons.associations.languages": {
		"rust": "rust-alt",
	},
	"catppuccin-icons.associations.extensions": {
		"rs": "rust-alt",
		"ron": "rust-alt",
	},
	"catppuccin-icons.associations.files": {
		"rustfmt.toml": "rust-alt-config",
		".rustfmt.toml": "rust-alt-config",
		"rust-toolchain.toml": "rust-alt-config",
		"clippy.toml": "rust-alt-config",
	},
	"editor.semanticHighlighting.enabled": true,
	"editor.guides.bracketPairs": true,
	"editor.bracketPairColorization.enabled": false,
	"editor.minimap.renderCharacters": false,
	// Extensions
	"vsix.restart.confirm": false,
	"vsix.extensions": [
		"zokugun.vsix-manager",
		"Catppuccin.catppuccin-vsc",
		"Catppuccin.catppuccin-vsc-icons",
		"EditorConfig.EditorConfig",
		"dnut.rewrap-revived",
		"hverlin.mise-vscode",
		"dbaeumer.vscode-eslint",
		"Orta.vscode-twoslash-queries",
		"rust-lang.rust-analyzer",
		"tamasfe.even-better-toml",
	],
	"extensions.supportUntrustedWorkspaces": {
		"tamasfe.even-better-toml": {
			"supported": "limited"
		}
	},
	"mise.checkForNewMiseVersion": false,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"Cargo.toml": "Cargo.lock",
		"*.sqlite": "${capture}.${extname}-*",
		"*.db": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.sdb": "${capture}.${extname}-*",
		"*.s3db": "${capture}.${extname}-*"
	},
	"diffEditor.ignoreTrimWhitespace": false,
}
